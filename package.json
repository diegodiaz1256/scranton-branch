{
  "name": "munder-difflin",
  "productName": "Scranton Branch",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Clones for you and your team, working 24/7 — a free, local-first multi-agent harness that turns the CLI coding agent you already run into a clone of you, coordinating an office of agents on your machine.",
  "main": "out/main/index.js",
  "author": "Scranton Branch",
  "homepage": "https://github.com/diegodiaz1256/scranton-branch",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegodiaz1256/scranton-branch.git"
  },
  "scripts": {
    "dev": "npm run assets && electron-vite dev",
    "build": "npm run assets && electron-vite build && npm run copy:main-assets",
    "assets": "node tools/zw-assets.cjs",
    "copy:main-assets": "node tools/copy-main-assets.cjs",
    "preview": "electron-vite preview",
    "demo": "node tools/demo.cjs",
    "demo:reset": "node tools/demo.cjs --reset",
    "postinstall": "install-electron && electron-rebuild -f && node tools/ensure-pty-perms.cjs && node tools/patch-node-pty-conpty.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:server",
    "build:server": "node tools/build-server.cjs",
    "test:focused": "node --test test/*.test.cjs",
    "check:links": "node tools/check-release-links.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "mqtt": "^5.16.0",
    "node-pty": "^1.1.0",
    "posthog-node": "^5.48.2",
    "tunnelmole": "^2.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.2.1",
    "@huggingface/transformers": "^4.3.0",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@noble/post-quantum": "^0.7.1",
    "@openai/agents-realtime": "^0.11.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "aedes": "^1.2.0",
    "commit-graph": "^2.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "pdfjs-dist": "^4.10.38",
    "i18next": "^26.3.6",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.52.2",
    "pixi.js": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-test-renderer": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/rebuild": "$@electron/rebuild"
    }
  }
}
