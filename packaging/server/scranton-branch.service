# Scranton Branch server — systemd unit (installed by install.sh).
#
# The server runs as root ONLY so it can start agents as the unprivileged
# `agent` user (SB_AGENT_UID/GID): that way agents cannot read the secret key
# (a systemd credential, readable by this service alone) or this process's
# environment. Everything else it does stays in /var/lib/scranton-branch and the
# office.
[Unit]
Description=Scranton Branch office (headless)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/scranton-branch/server.env
LoadCredential=md-secret-key:/etc/scranton-branch/secret.key
Environment=SB_SECRET_KEY_FILE=%d/md-secret-key
Environment=SB_DATA_DIR=/var/lib/scranton-branch
ExecStart=/usr/bin/env node /opt/scranton-branch/index.cjs
Restart=on-failure
RestartSec=5
# SIGTERM runs the app's full teardown (agents, servers, worktrees).
KillMode=mixed
TimeoutStopSec=30

# Limits — the whole office (server + every agent) shares these.
MemoryMax=8G
CPUQuota=400%
TasksMax=4096

# Hardening that leaves agents room to work in the office and their home.
NoNewPrivileges=no
ProtectSystem=full
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
